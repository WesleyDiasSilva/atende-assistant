# Chave de API do Amazon Bedrock (lida automaticamente pelo boto3)
AWS_BEARER_TOKEN_BEDROCK=

# Regiao onde o modelo sera invocado
AWS_REGION=us-east-1

# Inference profile do modelo rapido. O prefixo (global./us.) e obrigatorio.
MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Portas no host. Troque se voce ja tiver outro projeto usando 8000/5173.
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Postgres com pgvector, onde ficam os vetores da base de conhecimento.
#
# DB_HOST e DB_PORT abaixo valem para quem roda o backend na maquina (uvicorn):
# apontam para a porta que o compose publica no host. Dentro do compose o
# proprio docker-compose.yml sobrescreve os dois para db:5432.
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=atende_assistant

# Modelo que transforma texto em vetor. Trocar aqui invalida os vetores ja
# gravados — o mesmo modelo tem que ser usado na indexacao e na busca.
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Quantos trechos a busca devolve por pergunta.
TOP_K=4

# Quantos trechos a busca devolve quando a auto-correcao amplia o alcance, depois
# de a primeira passada nao ter achado a resposta na base.
TOP_K_AMPLIADO=10

# Tamanho do pedaco de texto e a sobreposicao entre pedacos vizinhos, em
# caracteres. Mudar qualquer um dos dois exige reindexar a base.
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Id de um Knowledge Base do Amazon Bedrock, para o modo de busca gerenciada.
#
# OPCIONAL. Sem ele os outros tres modos funcionam normalmente e o modo
# gerenciado aparece desabilitado na interface, com o motivo. So faz sentido
# preencher se voce provisionou um Knowledge Base na sua conta AWS — ele indexa os
# mesmos documentos, mas do lado da AWS, e nao le a base do pgvector.
#
# ATENCAO: este modo exige credencial IAM, e nao basta a chave de API do Bedrock.
# A consulta ao Knowledge Base vai pela API bedrock-agent-runtime, que precisa de
# assinatura SigV4; o AWS_BEARER_TOKEN_BEDROCK autentica o modelo, mas nao ela. Os
# caminhos sao dois: ter um ~/.aws/credentials valido (o docker-compose.yml monta
# essa pasta no conteiner, somente leitura), ou definir o par abaixo.
KNOWLEDGE_BASE_ID=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# LangSmith — tracing de cada execucao do grafo (nodes, idas ao modelo, tokens).
#
# OPCIONAL, e sem nenhuma linha de codigo: o langchain-core ja traz o SDK do
# LangSmith e le estas variaveis sozinho. Com LANGSMITH_TRACING=true e a chave
# preenchida, cada pergunta vira uma trace no projeto abaixo; com false (ou sem
# chave), o atendimento funciona igual e nada sai da maquina.
#
# Trocar qualquer valor aqui exige recriar o conteiner para ele reler o .env:
#   docker compose up -d backend
# (o --reload do uvicorn recarrega codigo, nao variavel de ambiente).
#
# A chave vem de smith.langchain.com → Settings → API Keys. Os nomes antigos
# (LANGCHAIN_TRACING_V2, LANGCHAIN_API_KEY, LANGCHAIN_PROJECT) tambem valem: o
# SDK aceita os dois prefixos.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=atende-assistant
# Regiao da conta: EUA https://api.smith.langchain.com, Europa
# https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# LangFuse — a segunda plataforma de tracing, open source e de terceiros.
#
# OPCIONAL. Diferente do LangSmith, precisa de codigo (um callback no invoke do
# grafo, em backend/app/observabilidade.py) — mas o liga/desliga continua aqui:
# sem as duas chaves, o callback nao e criado e o atendimento roda como antes.
#
# As chaves vem de cloud.langfuse.com → Settings do projeto → API Keys (par
# publica + secreta). LANGFUSE_HOST e a regiao da conta: Europa
# https://cloud.langfuse.com, EUA https://us.cloud.langfuse.com, self-hosted a
# URL da sua instalacao. O SDK 4.x prefere o nome LANGFUSE_BASE_URL e cai para
# LANGFUSE_HOST quando ele nao esta definido.
# Trocar qualquer valor aqui exige `docker compose up -d backend`.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
