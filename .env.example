# Chave de API do Amazon Bedrock (lida automaticamente pelo boto3)
AWS_BEARER_TOKEN_BEDROCK=

# Regiao onde o modelo sera invocado
AWS_REGION=us-east-1

# Inference profile do modelo rapido. O prefixo (global./us.) e obrigatorio.
MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Portas no host. Troque se voce ja tiver outro projeto usando 8000/5173.
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Postgres com pgvector, onde ficam os vetores da base de conhecimento.
#
# DB_HOST e DB_PORT abaixo valem para quem roda o backend na maquina (uvicorn):
# apontam para a porta que o compose publica no host. Dentro do compose o
# proprio docker-compose.yml sobrescreve os dois para db:5432.
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=atende_assistant

# Modelo que transforma texto em vetor. Trocar aqui invalida os vetores ja
# gravados — o mesmo modelo tem que ser usado na indexacao e na busca.
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Quantos trechos a busca devolve por pergunta.
TOP_K=4

# Tamanho do pedaco de texto e a sobreposicao entre pedacos vizinhos, em
# caracteres. Mudar qualquer um dos dois exige reindexar a base.
CHUNK_SIZE=800
CHUNK_OVERLAP=100
