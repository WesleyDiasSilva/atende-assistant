.env
.env.*
!.env.example
__pycache__/
.venv/

# Dados gravados em execucao — a fixture de pedidos continua versionada
backend/dados/*.jsonl

# Frontend
node_modules/
dist/
# Escrito pelo `npm install` da imagem dentro da pasta montada do host. O
# Dockerfile copia so o package.json e nao le este arquivo: ele e resultado de
# rodar o projeto, nao entrada dele.
frontend/package-lock.json

# Material do instrutor — nao vai para a turma
.claude/
CLAUDE.md

# Utilitarios locais de inspecao e de restauracao da base. Ficam de fora
# porque sao ferramentas de quem opera o projeto, nao parte do que ele faz.
backend/mostrar_prompt.py
backend/restaurar_base.py

# Anotacoes locais de quem opera o projeto.
aula.md

# Copias de seguranca feitas a mao antes de mexer nos dados de execucao.
*.bak
*.bak-*

# Resultado da ultima rodada da suite de avaliacao: base local do delta.
backend/avaliacao/.ultima-rodada.json

# Relatorio HTML da ultima rodada da suite, gerado a cada execucao.
backend/avaliacao/relatorio/
